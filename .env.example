# ====================================================================
# Antojo24 Frontend (React + Vite) - Variables de Entorno
# ====================================================================

# 1. URL base de la API REST (para backend local en puerto 5000)
# Debe incluir /api al final porque las llamadas en axios_*.js no incluyen el prefijo
VITE_API_BASE_URL_CLOUD=http://localhost:5000/api

# 2. URL del servidor WebSocket / Socket.IO
VITE_WEBSOCKET_URL=http://localhost:5000
